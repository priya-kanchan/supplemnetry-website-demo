# Copy this file to .env for local development (never commit .env)
# MongoDB Atlas connection string. Leave empty locally to use data/db.json instead.
MONGODB_URI=
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Secret key for "Forgot password?" on the admin login page (long random text, keep it private)
ADMIN_RECOVERY_KEY=
# Long random text (32+ characters) used to sign login tokens (JWT)
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters
